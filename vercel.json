{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm --filter @workspace/api-server build && corepack pnpm --filter @workspace/girafinha build",
  "outputDirectory": "artifacts/girafinha/dist/public",
  "rewrites": [
    {
      "source": "/api/event-payments/:id",
      "destination": "/api/shared/_router?__apiPath=event-payments/:id"
    },
    {
      "source": "/api/expenses/:id",
      "destination": "/api/shared/_router?__apiPath=expenses/:id"
    },
    {
      "source": "/api/external-events/:id",
      "destination": "/api/shared/_router?__apiPath=external-events/:id"
    },
    {
      "source": "/api/selected-extras/:id",
      "destination": "/api/shared/_router?__apiPath=selected-extras/:id"
    },
    {
      "source": "/api/venue-events/:id",
      "destination": "/api/shared/_router?__apiPath=venue-events/:id"
    },
    {
      "source": "/api/workshops/:workshopPath*",
      "destination": "/api/workshops/_router?__workshopPath=:workshopPath*"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/follow-up-sync",
      "schedule": "0 9 * * *"
    }
  ]
}
